  "narrative": {
    "northStar": "Fidelidade estrutural às referências",
    "overview": "A Sócio Estratégico define abertura, escala e cadência inicial. A V4 define missão, diagnóstico e maturidade. Logo, cores, fotos, métodos e fatos são Hurtz. O pedido atual exige preservar a estrutura escolhida pelo usuário.\n\nA primeira dobra contém pergunta central e dois objetivos numerados; fotografias ficam no capítulo institucional. A composição usa grandes superfícies, cartões, retratos, diagramas e navegação de deck.",
    "keyCharacteristics": [
      "Pergunta inicial e dois objetivos com medidas da referência.",
      "Montserrat em todo o runtime revisado.",
      "Container1180px e respiro96–136px.",
      "Primeiros capítulos na ordem da Sócio e diagnóstico/maturidade na cadência V4.",
      "Sombras difusas e bordas conforme as referências.",
      "Métodos, prova e próximos passos separados por vertical.",
      "Títulos no eixo esquerdo, versos fixos e navegação mobile visível, conforme Sócio."
    ],
    "rules": [
      {
        "name": "Fidelidade da abertura",
        "body": "Preservar pergunta central, destaque na palavra final, cartões numerados e geometria da referência.",
        "section": "layout"
      },
      {
        "name": "Estrutura antes de interpretação",
        "body": "Manter a função e a posição dos capítulos; alterar fatos para a realidade Hurtz sem criar narrativa visual livre.",
        "section": "layout"
      },
      {
        "name": "Marca Hurtz",
        "body": "Usar somente logo e paleta Hurtz, com tipografia e composição derivadas das referências escolhidas.",
        "section": "colors"
      },
      {
        "name": "Estados funcionais",
        "body": "Preservar teclado, foco, seleção, painéis e movimento reduzido.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preservar abertura e sequência corrigidas.",
      "Do usar fatos, fotos, logo e cores Hurtz.",
      "Do manter os métodos e provas das verticais separados.",
      "Do conferir desktop e celular contra as referências."
    ],
    "donts": [
      "Don’t recuperar a antiga capa fotográfica ou o slogan de entrada.",
      "Don’t criar nova narrativa livre para substituir os capítulos escolhidos.",
      "Don’t fabricar fatos para preencher blocos de autoridade.",
      "Don’t documentar a revisão com os tokens da implementação anterior."
    ]
