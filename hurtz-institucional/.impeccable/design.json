      "html": "<details class=\"ds-client\"><summary><strong>Luma<br>Reis</strong><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></summary><div><span>Clínicas</span><p>6 blefaroplastias vendidas no primeiro mês com a Hurtz.</p><button type=\"button\" class=\"ds-back\" onclick=\"this.closest('details').removeAttribute('open')\">Voltar</button></div></details>",
      "css": ".ds-client{border:1px solid var(--line);border-radius:16px;background:var(--paper);color:var(--ink);font-family:var(--font);overflow:hidden;max-width:280px}.ds-client summary{position:relative;list-style:none;cursor:pointer;min-height:152px;display:grid;place-items:center;text-align:center;padding:28px 18px}.ds-client summary::-webkit-details-marker{display:none}.ds-client summary strong{font-size:19px;line-height:1.18;letter-spacing:-.03em;font-weight:600}.ds-client summary svg{position:absolute;bottom:12px;right:14px;width:13px;height:13px;color:var(--strong);fill:none;stroke:currentColor;stroke-width:1.7}.ds-client[open] summary svg{transform:rotate(45deg)}.ds-client summary:hover{background:var(--sand)}.ds-client summary:focus-visible{outline:3px solid var(--strong);outline-offset:-5px}.ds-client>div{padding:18px;border-top:1px solid var(--line);min-height:130px;background:var(--sand)}.ds-client>div>span{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:var(--strong);font-weight:700}.ds-client p{font-size:11px;margin:12px 0 0;line-height:1.65} .ds-client{position:relative;height:152px}.ds-client summary{height:100%;min-height:0}.ds-client[open] summary{opacity:0}.ds-client>div{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;min-height:0;padding-bottom:38px;overflow:auto;border:0}.ds-back{position:absolute;right:18px;bottom:12px;min-height:24px;font-family:var(--font);font-size:9px;text-decoration:underline;border:0;background:transparent;color:var(--ink);cursor:pointer}.ds-back:focus-visible{outline:3px solid var(--strong);outline-offset:3px}"
