      "css": ".ds-button{display:inline-flex;justify-content:center;align-items:center;gap:14px;min-height:50px;padding:14px 22px;border:0;border-radius:10px;background:var(--strong);color:var(--paper);font-family:var(--font);font-size:12px;font-weight:700;cursor:pointer;transition:background .2s}.ds-button:hover{background:var(--deeper)}.ds-button:focus-visible{outline:3px solid var(--strong);outline-offset:5px}.ds-button:disabled{opacity:.35;cursor:default}.ds-button svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
    {
